; Engine configuration file. Written by hand for Godot 4.7, NOT yet opened in Godot.
; The exact feature string for 4.7 is UNVERIFIED. Open the project once in 4.7 and commit the rewritten file.
config_version=5

[application]
config/name="ECHO"
run/main_scene="res://game/scenes/bootstrap/boot.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
